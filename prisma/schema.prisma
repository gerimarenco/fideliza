generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Negocio {
  id                    String    @id @default(cuid())
  nombre                String
  tipo                  String
  ciudad                String
  emoji                 String
  activo                Boolean   @default(true)
  puntosXPeso           Int       @default(1000)
  email                 String?   @unique
  password              String?
  slug                  String?   @unique
  tiendanubeStoreId     String?   @unique
  tiendanubeAccessToken String?
  dragonfishBaseDeDatos String?   @unique
  dragonfishAgentToken  String?   @unique
  // Última vez que el agente local de Dragon Fish consultó pendientes (lo
  // hace cada 30s haya o no ventas). Sirve para mostrar en el panel si el
  // agente está andando sin confundir "no hubo ventas" con "se cayó".
  dragonfishUltimoContacto DateTime?
  tema                  Json?
  // Mensaje/promoción propia que se muestra en la pantalla pública de
  // auto-registro (/registro/[slug]) — ej. "a las 6 hamburguesas, la 7ma
  // gratis". Si no está cargado, la pantalla usa un texto genérico.
  mensajeRegistro       String?
  // Puntos que se acreditan solos el día del cumpleaños de cada cliente
  // (ver netlify/functions/regalo-cumpleanos.mjs). null/0 = desactivado —
  // por ahora solo Peperina lo tiene cargado.
  regaloCumpleanosPuntos Int?
  // Bonificación de bienvenida (ver lib/bienvenida.js): puntos que recibe
  // una cuenta nueva creada entre bienvenidaDesde (incluido) y
  // bienvenidaHasta (excluido). Cualquiera de los tres en null = sin promoción.
  bienvenidaPuntos Int?
  bienvenidaDesde  DateTime?
  bienvenidaHasta  DateTime?
  // Sitio propio del negocio (ej. su tienda online) — se muestra como link
  // en el panel del cliente para cruzar tráfico entre los dos. Opcional.
  sitioWeb              String?
  // Contacto de soporte que ve la clienta en el menú ⋮ de su panel. Antes
  // apuntaba fijo a soporte@retornar.com.ar (una casilla que no existía, y
  // que además hubiera sido la misma para cualquier negocio). Cada negocio
  // carga el suyo; si no carga ninguno, la opción no aparece.
  soporteEmail          String?
  // Solo dígitos, con código de país y área (ej. 5492324123456) para wa.me.
  soporteWhatsapp       String?
  // Meses sin usar un lote de puntos para que venza (ver
  // netlify/functions/vencimiento-puntos.mjs). null/0 = desactivado — por
  // ahora solo Peperina lo tiene cargado, en 6.
  vencimientoPuntosMeses Int?
  // Texto legal del programa de puntos que ve la clienta en "Bases y
  // condiciones" (menú ⋮ del panel). Antes era una constante fija en el
  // código con el texto de Peperina hardcodeado — ahora es por negocio,
  // igual que mensajeRegistro/sitioWeb. Si no está cargado, la pantalla
  // muestra un aviso de que este negocio todavía no lo completó.
  basesCondiciones      String?
  // Puntos que ganan tanto quien invita como la persona invitada cuando
  // esta última hace su primera compra (ver lib/referidos.js). null/0 =
  // desactivado, mismo criterio que regaloCumpleanosPuntos.
  puntosReferido        Int?
  createdAt             DateTime  @default(now())
  clientes    Cliente[]
  premios     Premio[]
  facturasPendientes    FacturaPendiente[]
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String?
  telefono  String?
  email     String   @unique
  password  String
  puntos    Int      @default(0)
  negocioId String
  negocio   Negocio  @relation(fields: [negocioId], references: [id])
  createdAt DateTime @default(now())
  canjes    Canje[]
  // Nullable porque solo se piden en el auto-registro público
  // (/registro/[slug]) — un cliente creado a mano por el negocio o de alta
  // automática por Dragon Fish no los tiene.
  fechaNacimiento DateTime?
  dni             String?
  sexo            String?

  // Código corto para compartir e invitar amigas (ver lib/referidos.js) —
  // nullable porque se genera recién la primera vez que alguien abre
  // "Referí a una amiga" en el panel, no al crear la cuenta.
  codigoReferido String? @unique
  // Quién la invitó, si se registró con el link de otra clienta. Nunca
  // cambia una vez seteado. Sin relación en cascada: un cliente no se
  // borra nunca desde la app, no hace falta contemplar ese caso.
  referidoPorId  String?
  referidoPor    Cliente?  @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos      Cliente[] @relation("Referidos")
  // Si ya se le pagó a quien la invitó el bono de "primera compra
  // referida" — evita tener que recontar todo el historial de compras en
  // cada acreditación solo para saber si ya se pagó antes.
  referidoRecompensado Boolean @default(false)
  // Si ya recibió la bonificación de bienvenida: se marca en la misma
  // transacción que la acredita, así nunca se paga dos veces.
  bienvenidaOtorgada Boolean @default(false)

  @@index([negocioId])
}

model Premio {
  id        String  @id @default(cuid())
  nombre    String
  puntos    Int
  emoji     String
  activo    Boolean @default(true)
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  canjes    Canje[]
  // Vínculo opcional con un producto real de la tienda Tiendanube del
  // negocio: habilita el click "ver producto" y, al canjear, un cupón de
  // Tiendanube por el valor de ese producto (ver Canje abajo). El id es el
  // que usa la API de Tiendanube para pedir el precio actual; la URL la
  // carga el negocio a mano (copiada de su propia tienda), no se arma sola.
  tiendanubeProductoId  String?
  tiendanubeProductoUrl String?
  // Alternativa a lo de arriba: el premio da un % de descuento en toda la
  // tienda en vez de un producto puntual (ej. "10% descuento" → 10). Un
  // premio no debería tener las dos cosas cargadas a la vez, pero no hace
  // falta impedirlo a nivel de base: si pasara, tiendanubeProductoId gana.
  tiendanubeDescuentoPorcentaje Int?
  // Tercera alternativa: descuento de un monto fijo en pesos (ej. "$70.000
  // off"), con una compra mínima obligatoria para poder usarlo
  // (tiendanubeDescuentoMontoMinimo). Esto es lo que permite prometer "hasta
  // $70.000 de descuento" sin exponer a el negocio a que alguien compre
  // justo ese monto y se lo lleve gratis — ver crearCuponMontoFijo en
  // lib/tiendanube.js. Si tiendanubeDescuentoMontoMinimo no se carga, se usa
  // el propio monto como mínimo (mismo piso que un cupón de producto: nunca
  // se puede quedar en $0 para el negocio).
  tiendanubeDescuentoMonto        Int?
  tiendanubeDescuentoMontoMinimo  Int?

  @@index([negocioId])
}

model Canje {
  id        String   @id @default(cuid())
  clienteId String
  premioId  String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  premio    Premio   @relation(fields: [premioId], references: [id])
  createdAt DateTime @default(now())
  entregado Boolean  @default(false)
  // Cupón de Tiendanube generado al canjear un premio vinculado (ver Premio
  // arriba). Se guarda para que el negocio lo pueda consultar si la clienta
  // lo perdió, y tiendanubeCuponError para diagnosticar canjes donde los
  // puntos ya se descontaron pero el cupón no se pudo generar (token sin
  // permisos, producto borrado, Tiendanube caído, etc.) — en ese caso el
  // negocio tiene que entregar el descuento a mano.
  tiendanubeCuponCodigo String?
  tiendanubeCuponError  String?
  // Estado del cupón según Tiendanube (ver lib/estadoCupon.js): "disponible",
  // "utilizado", "vencido" o "anulado". null = todavía no se pudo verificar.
  // cuponVerificadoEn: última vez que se consultó a Tiendanube. Un cupón
  // pasa a "utilizado" solo si Tiendanube lo confirma (una orden pagada que
  // lo trae, o su contador de usos), nunca por tiempo ni por un clic.
  cuponEstado       String?
  cuponVerificadoEn DateTime?
  cuponUsadoEn      DateTime?
  cuponPedidoId     String?
  // Clave que manda el panel al confirmar un canje (una por confirmación):
  // si el mismo pedido llega dos veces (doble clic, reintento de red, dos
  // pedidos a la vez), el segundo devuelve el canje ya hecho en vez de
  // crear otro (ver app/api/canjes). null en canjes viejos o hechos sin ella.
  claveIdempotencia String? @unique
  // Cómo era el premio al canjearlo: si el negocio lo edita después, el
  // historial y las instrucciones del cupón siguen mostrando lo que se
  // canjeó. null en canjes anteriores a este campo (se usa el premio actual).
  premioNombre    String?
  puntosUsados    Int?
  premioBeneficio Json?

  @@index([clienteId])
  @@index([premioId])
}

// Idempotencia de webhooks: guarda qué notificaciones ya procesamos para no
// sumar puntos dos veces si un proveedor (Mercado Pago, Tiendanube, Dragon
// Fish) reenvía la misma notificación.
model WebhookEvento {
  id                String   @id @default(cuid())
  proveedor         String
  referenciaExterna String
  createdAt         DateTime @default(now())

  @@unique([proveedor, referenciaExterna])
}

// Facturas de Dragon Fish avisadas por webhook (que solo trae un Código, sin
// datos de la venta) a la espera de que el agente local las resuelva contra
// la API REST local de Dragon Fish y reporte el resultado.
model FacturaPendiente {
  id        String   @id @default(cuid())
  negocioId String
  negocio   Negocio  @relation(fields: [negocioId], references: [id])
  codigo    String
  entidad   String   // tipo de comprobante que mandó el webhook (FACTURA, FACTURAELECTRONICA, TICKETFACTURA, FACTURAAGRUPADA)
  fecha     String
  hora      String
  procesado Boolean  @default(false)
  resultado String?  // "acreditado" | "sin_cliente" | "sin_datos" | "duplicado", null mientras está pendiente
  // Cuántas veces se le entregó al agente sin que la resolviera. Los
  // pendientes se reparten de menos a más intentos: una factura que el
  // agente no logra resolver (ej. Dragon Fish no la encuentra) ya no tapa a
  // las nuevas, que antes podían quedar atrás de las mismas 20 para siempre.
  intentos  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([negocioId, codigo])
  @@index([negocioId, procesado])
}

// Historial de cada vez que se otorgan puntos (compra manual o webhook).
// Cliente.puntos sigue siendo el contador acumulado; esto es lo que permite
// calcular estadísticas por rango de fechas (ej. puntos otorgados este mes).
model MovimientoPuntos {
  id        String   @id @default(cuid())
  clienteId String
  negocioId String   // denormalizado a propósito, para no tener que hacer join en las consultas de stats
  puntos    Int
  origen    String   // "manual" | "mercadopago" | "tiendanube" | "dragonfish" | "cumpleanos" | "vencimiento" | "referido_invitador" | "referido_invitado"
  createdAt DateTime @default(now())
  // Cuánto de este lote de puntos sigue "vivo" (ni canjeado ni vencido) —
  // solo tiene sentido en un lote que suma puntos (puntos > 0); arranca
  // igual a `puntos` y baja a medida que un canje lo consume (FIFO, el lote
  // más viejo primero, ver app/api/canjes) o que vence a los 6 meses (ver
  // netlify/functions/vencimiento-puntos.mjs). En los movimientos que restan
  // puntos (canjes no generan movimiento propio; vencimiento sí, con
  // `origen: "vencimiento"`) queda en null, no aplica.
  saldoRestante Int?
  // Cuándo se le avisó a la clienta que este lote estaba por vencer (ver
  // netlify/functions/vencimiento-puntos.mjs y lib/vencimientoPuntos.js).
  // null = todavía no se avisó; cada lote se avisa una sola vez.
  avisoVencimientoEn DateTime?
  // Solo en los movimientos de vencimiento (origen "vencimiento"): cuándo
  // salió el mail "vencieron puntos". null = todavía no se pudo mandar; la
  // tarea diaria lo reintenta unos días (ver netlify/functions/vencimiento-puntos.mjs).
  avisoVencidoEn DateTime?

  @@index([negocioId, createdAt])
  @@index([clienteId, saldoRestante])
}

// Códigos de un solo uso para "Olvidé mi contraseña" (clientes y negocios
// -- el admin no tiene fila acá, su contraseña sale de una variable de
// entorno, ver lib/auth.js). Solo se guarda el hash del código (igual
// criterio que una contraseña): si se filtrara la base, nadie podría usar
// estas filas para resetear una cuenta sin tener además el código original
// que se mandó por mail. usuarioId es denormalizado a propósito (sin FK):
// apunta a un Cliente o a un Negocio según `tipo`, nunca los dos a la vez.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  tipo      String    // "cliente" | "negocio"
  usuarioId String
  expiraEn  DateTime
  // Se marca en vez de borrar la fila al usarse, para no poder reusar el
  // mismo código dos veces aunque todavía no haya vencido.
  usadoEn   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId, tipo])
}

// Intentos de login con usuario y contraseña, para frenar a quien prueba
// contraseñas una tras otra (ver lib/limiteLogin.js). Se guardan HMAC del
// email normalizado y de la IP, nunca los datos en sí. Los exitosos se
// borran apenas se confirma la contraseña; el resto, al día siguiente.
model IntentoLogin {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([emailHash, ipHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}
