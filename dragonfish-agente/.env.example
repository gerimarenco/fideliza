# Copiar este archivo a ".env" (en la misma carpeta) y completar los
# valores reales — ver dragonfish-agente/README.md para cómo conseguir
# cada uno desde el propio Dragon Fish y desde el panel de Fideliza.
# El ".env" nunca se sube a git (ya está en .gitignore).

FIDELIZA_AGENT_TOKEN=

DRAGONFISH_BASE_URL=http://localhost:8008/api.Dragonfish
DRAGONFISH_ID_CLIENTE=
DRAGONFISH_TOKEN=

# Opcionales, dejar en blanco si no hacen falta (ver README):
DRAGONFISH_BASE_DE_DATOS=
FIDELIZA_BASE_URL=
POLL_INTERVAL_MS=
